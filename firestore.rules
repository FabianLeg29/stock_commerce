rules_version = '2';

// ============================================================
// Suivi Stock — La Légumière
// Rôles (stockés dans users/{uid}.role) :
//   admin      : tout, y compris gestion des comptes et de la liste des opérateurs
//                de stock du soir (collection "parametres")
//   commerce   : gestion complète des produits (collection "produits" — création,
//                désignation, famille/variete/conditionnement/suremballage, prix
//                d'achat/unité, actif, suppression) et des listes de référence dont
//                ces champs sont issus (collection "referentiels"), ventes/réservations
//                du jour individuellement par commercial (collection "commerce", un
//                document par produit+jour+commercial — chacun ne peut écrire QUE son
//                propre document), achats/livraisons (collection "achats"), + validation
//                du stock du soir (champ "importe" de saisieStock) qui met à jour
//                dernierStock (pas les valeurs saisies par la production)
//   production : stock du soir (collection "saisieStock"), + réactivation d'un
//                produit inactif existant (champ "actif" uniquement)
//   viewer     : lecture seule partout
//   aucun      : rôle par défaut au 1er login — aucun accès à l'application
//                tant qu'un administrateur n'a pas attribué un rôle
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function monRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function estAdmin() {
      return connecte() && monRole() == 'admin';
    }

    function estCommerce() {
      return connecte() && (monRole() == 'commerce' || monRole() == 'admin');
    }

    function estProduction() {
      return connecte() && (monRole() == 'production' || monRole() == 'admin');
    }

    // ---- Comptes / rôles ----
    match /users/{uid} {
      allow read: if connecte();
      // Un compte ne peut pas modifier son propre rôle (sécurité anti-blocage).
      // Auto-création à la 1ère connexion, uniquement pour soi-même et uniquement en rôle 'aucun'
      // (empêche qu'un utilisateur se crée directement en 'admin' en contournant l'application ;
      // tant que l'administrateur n'a pas changé ce rôle, le compte n'a accès à rien).
      allow create: if connecte() && request.auth.uid == uid && request.resource.data.role == 'aucun';
      allow update: if estAdmin() && request.auth.uid != uid;
      allow delete: if estAdmin() && request.auth.uid != uid;
    }

    // ---- Produits (un document par produit) ----
    // admin et commerce : gestion complète (créer, tout modifier, supprimer) depuis
    // l'onglet Produits — désignation, famille/variete/conditionnement/suremballage,
    // prix d'achat/unité, actif.
    // production : peut modifier UNIQUEMENT le champ actif d'un produit existant
    // (réactiver un produit inactif depuis la liste de l'onglet Production) — ne
    // peut pas créer de nouveau produit ni le supprimer.
    match /produits/{produitId} {
      allow read: if connecte();
      allow create: if estCommerce();
      allow delete: if estCommerce();
      allow update: if estCommerce() ||
        (estProduction() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actif']));
    }

    // ---- Listes de référence (Famille / Variété / Conditionnement / Suremballage) ----
    // Un seul document, un tableau de valeurs par catégorie. Gérées depuis l'onglet
    // Produits par l'admin et le rôle commerce (comme le reste de cet onglet).
    match /referentiels/{docId} {
      allow read: if connecte();
      allow write: if estCommerce();
    }

    // ---- Paramètres divers (ex: liste des opérateurs de stock du soir) ----
    // Gérés exclusivement par l'admin depuis l'onglet Paramètres — lecture ouverte à
    // tous les rôles connectés (le choix d'un opérateur se fait depuis l'onglet
    // Stock du soir, accessible à la production).
    match /parametres/{docId} {
      allow read: if connecte();
      allow write: if estAdmin();
    }

    // ---- Cache "dernier stock connu" par produit ----
    // Écrit uniquement par le rôle commerce, lors de la validation/import du
    // stock du soir saisi par la production (voir saisieStock) — la production
    // ne modifie plus ce cache directement.
    match /dernierStock/{docId} {
      allow read: if connecte();
      allow write: if estCommerce();
    }

    // ---- Saisie du stock du soir (Production) ----
    // production : écrit librement ses saisies (haut/bas/total, importe:false).
    // commerce : peut UNIQUEMENT faire passer le champ importe à true, lors de la
    // validation — ne peut pas modifier les valeurs saisies par la production.
    match /saisieStock/{docId} {
      allow read: if connecte();
      allow write: if estProduction();
      allow update: if estCommerce() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['importe']);
    }

    // ---- Brouillons de session de stock du soir (persistés pendant la saisie) ----
    // Un document par jour + côté + opérateur, écrit/effacé uniquement par le rôle
    // production (comme saisieStock) — permet de reprendre une session interrompue
    // et de voir les sessions en cours démarrées par d'autres opérateurs.
    match /brouillonsStockSoir/{docId} {
      allow read: if connecte();
      allow write: if estProduction();
    }

    // ---- Ventes/réservations du jour, par commercial ----
    // Un document par produit + jour + commercial (id = ${date}__${slug(produit)}__${slug(email)}).
    // Un compte commerce ne peut écrire QUE le document dont le champ "commercial"
    // correspond à son propre email (n'écrase pas les saisies des autres) ; l'admin
    // peut écrire n'importe quel document (correction).
    match /commerce/{docId} {
      allow read: if connecte();
      allow write: if estAdmin() ||
        (estCommerce() && request.resource.data.commercial == request.auth.token.email);
    }

    // ---- Achats (une livraison = un document, plusieurs lignes produit) ----
    match /achats/{achatId} {
      allow read: if connecte();
      allow create, update, delete: if estCommerce();
    }

    // ---- Historique (journal des actions) ----
    match /transactions/{docId} {
      allow read: if connecte();
      allow create: if estProduction() || estCommerce();
      allow update: if false;
      allow delete: if estAdmin();
    }
  }
}
